{
  "name": "pi-current",
  "version": "0.0.0",
  "private": true,
  "description": "Web access and personal discovery for Pi.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "docs/i18n/README.zh-CN.md",
    "examples/source-plugin.mjs"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pi --extension ./src/index.ts",
    "lint": "biome lint --error-on-warnings",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.19.19",
    "playwright": "1.64.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "29.1.1"
  },
  "overrides": {
    "undici@>=8.0.0 <8.12.2": "8.12.2"
  }
}
